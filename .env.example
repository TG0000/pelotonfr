# PelotonFR — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs

# ── Neon PostgreSQL ──────────────────────────────────────────
# Créez une base sur neon.tech, activez l'extension PostGIS
# puis lancez: psql $DATABASE_URL -f db/schema.sql
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-west-1.aws.neon.tech/pelotonfr?sslmode=require"

# ── Clerk (authentification optionnelle) ─────────────────────
# Créez une application sur clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Cron security ─────────────────────────────────────────────
# Générez avec: openssl rand -hex 32
# À ajouter aussi dans les secrets GitHub (DATABASE_URL + CRON_SECRET)
CRON_SECRET="your-random-secret-here"

# ── MapTiler (optionnel, pour de meilleures tuiles cartographiques) ──
# Clé gratuite sur maptiler.com (100k map loads/mois)
NEXT_PUBLIC_MAPTILER_KEY=""
