# Copy to .env.local. Never reuse production database credentials in a preview.
DATABASE_URL="postgresql://user:password@host/pelotonfr?sslmode=verify-full"
# Required: generate independent random values with openssl rand -hex 32.
BETTER_AUTH_SECRET=""
TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Explicit Better Auth user IDs, comma-separated. Email addresses never grant access.
ADMIN_USER_IDS=""
# Transactional email. Set a verified sender address with the selected provider.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
RESEND_API_KEY=""
# L'expéditeur est une adresse du domaine authentifié chez Brevo ; personne
# ne relève cette boîte, alors les réponses partent vers ALERT_REPLY_TO.
ALERT_FROM_EMAIL=""
ALERT_REPLY_TO=""
# Optional identity providers. Register each environment's callback origin separately.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple requires a paid Developer membership. Leave ALL empty until configured.
# Service ID, Team ID, Key ID, and downloaded .p8 key (literal \n accepted).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Optional map and imagery providers. Restrict public keys by HTTP origin and API.
NEXT_PUBLIC_MAPTILER_KEY=""
GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_MAPS_SERVER_KEY=""
MAPILLARY_TOKEN=""
# Explicit opening budgets; blank/zero disables embedded Street View. Not a billing guarantee.
# En panoramas, pas en ouvertures : une visite d'un tour de 5 km en charge
# une quarantaine. Vide = Street View reste éteint.
STREETVIEW_DAILY_CAP=""
STREETVIEW_MONTHLY_CAP=""
# Keep false until collective Strava use has been reviewed and approved.
# Laisser vide : tout ce qui vient de Strava est visible. Poser "false" le
# jour où le circuit passe derrière la version premium.
ENABLE_PUBLIC_STRAVA=""
# Optional collectors; not necessary to browse the site.
ANTHROPIC_API_KEY=""
